# Copy these NAMES into Vercel > Project > Settings > Environment Variables.
# NEVER commit real values. NEVER put the service role key in any file inside /public.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase > Project Settings > API > "anon" / publishable key (public by design)
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase > Project Settings > API > "service_role" / secret key. SECRET. Server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Your public website address, no trailing slash (used for the password-reset email link)
SITE_URL=https://your-project.vercel.app
