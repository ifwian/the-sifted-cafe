# Copy this file to ".env" and fill in your own values.
# The real ".env" file must NEVER be shared, zipped, or committed to Git.

# --- Web server ---
PORT=3000
# Use "development" while coding. Use "production" only when deployed behind HTTPS
# (production turns on the "Secure" flag for the login cookie).
NODE_ENV=development

# --- MySQL connection (the account you use in MySQL Workbench) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=put_your_mysql_password_here
DB_NAME=sifted_cafe_db
# Set to "true" when the database is in the cloud (the Vercel deployment).
# Leave it false on your own computer.
DB_SSL=false

# --- Admin login session ---
# How many hours an admin stays signed in.
SESSION_HOURS=8
